#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"Cannot find in which journal to import the statement for account %s. Please "
"configure the journal first."
msgstr ""
"ບໍ່ພົບວ່າຈະນຳເຂົ້າໃບແຈ້ງຍອດສຳລັບບັນຊີ %s ເຂົ້າໃນປຶ້ມບັນຊີໃດ. ກະລຸນາຕັ້ງຄ່າປຶ້ມບັນຊີກ່ອນ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_journal.py:0
msgid ""
"Cannot find in which journal to import this statement. Please manually "
"select a journal."
msgstr ""
"ບໍ່ພົບວ່າຈະນຳເຂົ້າໃບແຈ້ງຍອດນີ້ເຂົ້າໃນປຶ້ມບັນຊີໃດ. ກະລຸນາເລືອກປຶ້ມບັນຊີດ້ວຍຕົນເອງ."

#. module: account_bank_statement_import
#. odoo-python
#: code:addons/account_bank_statement_import/models/account_bank_statement.py:0
