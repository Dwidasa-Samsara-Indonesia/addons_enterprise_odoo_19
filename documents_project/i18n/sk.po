#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/project_project.py:0
msgid ""
"The \"%(folder)s\" folder should either be in the \"%(company)s\" company "
"like this project or be open to all companies."
msgstr ""
"Zložka „%(folder)s“ by mala byť buď v spoločnosti „%(company)s“, ako je to v "
"tomto projekte, alebo by mala byť prístupná pre všetky spoločnosti."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/documents_document.py:0
msgid ""
"The \"%s\" folder is required by the Project application and cannot be "
"archived."
msgstr ""
"Zložka „%s“ je povinnou súčasťou žiadosti o Projekt a nie je možné ju "
"archivovať."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/documents_document.py:0
msgid ""
"This action can't be performed, as it would remove the folders used by the "
"following projects:\n"
"%(projects)s\n"
"To continue, choose different folders for these projects."
msgstr ""
"Túto akciu nie je možné vykonať, pretože by to viedlo k odstráneniu zložiek "
"používaných nasledujúcimi projektmi:\n"
"%(projects)s\n"
"Ak chcete pokračovať, vyberte pre tieto projekty iné zložky."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/wizard/documents_operation.py:0
msgid "This document belongs to %(task)s."
msgstr "Tento dokument patrí k %(task)s."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/documents_document.py:0
msgid ""
"This folder should remain in the same company as the \"%(project)s\" project "
"to which it is linked. Please update the company of the \"%(project)s\" "
"project, or leave the company of this folder empty."
msgstr ""
"Táto zložka by mala zostať v tej istej spoločnosti ako projekt „%(project)s"
"“, s ktorým je prepojená. Aktualizujte prosím spoločnosť projektu „%(project)"
"s“ alebo nechajte spoločnosť tejto zložky prázdnu."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/documents_document.py:0
msgid ""
"This folder should remain in the same company as the following projects to "
"which it is linked:\n"
"%s\n"
"\n"
"Please update the company of those projects, or leave the company of this "
"folder empty."
msgstr ""
"Táto zložka by mala zostať v tej istej spoločnosti ako nasledujúce projekty, "
"s ktorými je prepojená:\n"
"%s\n"
"\n"
"Aktualizujte prosím spoločnosť týchto projektov alebo nechajte pole "
"spoločnosti tejto zložky prázdne."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/documents_document.py:0
msgid "Uh-oh! The project app needs the \"%s\" folder, so you can’t delete it."
msgstr ""
"Ach-jaj! Aplikácia Projekty potrebuje priečinok „%s“, takže ho nemôžete "
"odstrániť."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/documents_document.py:0
msgid "You cannot archive the project base folder (%s)."
msgstr "Základný priečinok projektu (%s) nie je možné archivovať."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/project_project.py:0
msgid ""
"You cannot change the company of this project, because its folder is linked "
"to the other following projects that are still in the \"%(other_company)s\" "
"company:\n"
"%(other_folders)s\n"
"\n"
"Please update the company of all projects so that they remain in the same "
"company as their folder, or leave the company of the \"%(folder)s\" folder "
"blank."
msgstr ""
"Spoločnosť tohto projektu nemôžete zmeniť, pretože jeho zložka je prepojená "
"s ďalšími nasledujúcimi projektmi, ktoré sa stále nachádzajú v spoločnosti „%"
"(other_company)s“:\n"
"%(other_folders)s\n"
"\n"
"Aktualizujte prosím spoločnosť všetkých projektov tak, aby zostali v tej "
"istej spoločnosti ako ich zložka, alebo nechajte pole spoločnosti zložky „%"
"(folder)s“ prázdne."

#. module: documents_project
#. odoo-python
#: code:addons/documents_project/models/documents_document.py:0
msgid "You cannot set a company on the %s folder."
msgstr "Pre priečinok „%s“ nemôžete nastaviť spoločnosť."

