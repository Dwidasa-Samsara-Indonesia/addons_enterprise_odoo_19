#. module: stock_accountant
#: model:ir.model,name:stock_accountant.model_res_config_settings
msgid "Config Settings"
msgstr "ການກຳນົດຄ່າ"

#. module: stock_accountant
#: model_terms:ir.ui.view,arch_db:stock_accountant.res_config_settings_view_form
msgid ""
"Default accounts, valuation and cost method for the company. These option "
"can be overridden on each product category"
msgstr ""
"ບັນຊີເລີ່ມຕົ້ນ, ການຕີລາຄາມູນຄ່າ ແລະ ວິທີການຕົ້ນທຶນສຳລັບບໍລິສັດ. ຕົວເລືອກເຫຼົ່ານີ້ສາມາດກຳນົດທັບໄດ້ໃນແຕ່ລະໝວ"
"ດສິນຄ້າ"

#. module: stock_accountant
#: model:ir.model.fields,field_description:stock_accountant.field_res_config_settings__display_name
msgid "Display Name"
msgstr "ຊື່ທີ່ສະແດງ"

#. module: stock_accountant
#: model:ir.model.fields,field_description:stock_accountant.field_res_config_settings__id
msgid "ID"
msgstr "ໄອດີ"

#. module: stock_accountant
#: model_terms:ir.ui.view,arch_db:stock_accountant.res_config_settings_view_form
msgid "Inventory Accounting"
msgstr "ການບັນຊີສາງສິນຄ້າ"

#. module: stock_accountant
#: model:ir.model.fields,field_description:stock_accountant.field_res_config_settings__cost_method
msgid "Inventory Cost Method"
msgstr "ວິທີການຕົ້ນທຶນສາງສິນຄ້າ"

#. module: stock_accountant
#: model:ir.model.fields,field_description:stock_accountant.field_res_config_settings__inventory_period
msgid "Inventory Period"
msgstr "ຮອບວຽນສາງສິນຄ້າ"

#. module: stock_accountant
#: model:ir.model.fields,field_description:stock_accountant.field_res_config_settings__valuation_method
#: model:ir.ui.menu,name:stock_accountant.menu_action_stock_account_report_stock_valuation
#: model_terms:ir.ui.view,arch_db:stock_accountant.res_config_settings_view_form
msgid "Inventory Valuation"
msgstr "ການຕີລາຄາມູນຄ່າສາງສິນຄ້າ"

#. module: stock_accountant
#: model_terms:ir.ui.view,arch_db:stock_accountant.res_config_settings_view_form
msgid "Journal"
msgstr "ສະມຸດລາຍວັນ"

#. module: stock_accountant
#: model_terms:ir.ui.view,arch_db:stock_accountant.res_config_settings_view_form
msgid ""
"Other accounts can be defined on \"Inventory Loss\" and \"Production\" on "
"dedicated"
msgstr ""
"ບັນຊີອື່ນໆ ສາມາດກຳນົດໄດ້ໃນ \"ການສູນເສຍສາງ\" ແລະ \"ການຜະລິດ\" ໃນສ່ວນສະເພາະ"

#. module: stock_accountant
#: model_terms:ir.ui.view,arch_db:stock_accountant.res_config_settings_view_form
msgid "Periodic Valuation"
msgstr "ການຕີລາຄາມູນຄ່າຕາມໄລຍະເວລາ"

#. module: stock_accountant
#: model:ir.model.fields,field_description:stock_accountant.field_res_config_settings__stock_journal
msgid "Stock Journal"
msgstr "ສະມຸດລາຍວັນສາງ"

#. module: stock_accountant
#: model:ir.model.fields,field_description:stock_accountant.field_res_config_settings__stock_valuation_account_id
msgid "Stock Valuation Account"
msgstr "ບັນຊີການຕີລາຄາມູນຄ່າສາງ"

#. module: stock_accountant
#: model_terms:ir.ui.view,arch_db:stock_accountant.res_config_settings_view_form
msgid "Valuation Account"
msgstr "ບັນຊີການຕີລາຄາມູນຄ່າ"

#. module: stock_accountant
#: model_terms:ir.ui.view,arch_db:stock_accountant.res_config_settings_view_form
msgid "locations"
msgstr "ສະຖານທີ່"
