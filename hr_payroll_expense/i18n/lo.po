#. module: hr_payroll_expense
#: model:ir.model,name:hr_payroll_expense.model_hr_expense
msgid "Expense"
msgstr "ຄ່າໃຊ້ຈ່າຍ"

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "Expense (\"%(name)s\") was removed from the next payslip."
msgstr "ຄ່າໃຊ້ຈ່າຍ (\"%(name)s\") ໄດ້ຖືກຖອນອອກຈາກໃບລາຍຈ່າຍເງິນເດືອນຖັດໄປແລ້ວ."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid "Expense (\"%(name)s\") will be added to the next payslip."
msgstr "ຄ່າໃຊ້ຈ່າຍ (\"%(name)s\") ຈະຖືກເພີ່ມເຂົ້າໃນໃບລາຍຈ່າຍເງິນເດືອນຖັດໄປ."

#. module: hr_payroll_expense
#. odoo-python
#: code:addons/hr_payroll_expense/models/hr_expense.py:0
msgid ""
"Expense reimbursement rule needs to be configured to add expenses to payslips.\n"
"Please create one salary rule with the \"%(code)s\" code on the relevant salary structures."
msgstr ""
"ຕ້ອງໄດ້ກຳນົດຄ່າກົດເກນການຊຳລະຄືນຄ່າໃຊ້ຈ່າຍ ເພື່ອເພີ່ມຄ່າໃຊ້ຈ່າຍເຂົ້າໃນໃບລາຍຈ່າຍເງິນເດືອນ.\n"
"ກະລຸນາສ້າງກົດເກນເງິນເດືອນໜຶ່ງ ດ້ວຍລະຫັດ \"%(code)s\" ໃນໂຄງສ້າງເງິນເດືອນທີ່ກ່ຽວຂ້ອງ."

#. module: hr_payroll_expense
#. odoo-python
