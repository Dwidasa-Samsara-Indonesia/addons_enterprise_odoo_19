#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid ""
"If lead is created for existing contact, schedule a call with their "
"salesperson."
msgstr ""
"ຖ້າຫາກຜູ້ມີທ່າແຮງຖືກສ້າງຂຶ້ນສໍາລັບຜູ້ຕິດຕໍ່ທີ່ມີຢູ່ແລ້ວ, ໃຫ້ກໍານົດເວລາການໂທກັບພະນັກງານຂາຍຂອງພວກເຂົາ."

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "If not opened, priority = 0"
msgstr "ຖ້າຫາກບໍ່ໄດ້ເປີດ, ຄວາມສໍາຄັນ = 0"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "If replied, assign 3 stars"
msgstr "ຖ້າຫາກມີການຕອບກັບ, ໃຫ້ກໍານົດເປັນ 3 ດາວ"

#. module: marketing_automation_crm
#: model:ir.model,name:marketing_automation_crm.model_marketing_campaign
msgid "Marketing Campaign"
msgstr "ແຄມເປນການຕະຫຼາດ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Next activity: Call"
msgstr "ກິດຈະກໍາຕໍ່ໄປ: ການໂທ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Not Opened, Low Priority"
msgstr "ຍັງບໍ່ໄດ້ເປີດ, ຄວາມສໍາຄັນຕໍ່າ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Prioritize Hot Leads"
msgstr "ຈັດລໍາດັບຄວາມສໍາຄັນໃຫ້ກັບຜູ້ມີທ່າແຮງທີ່ມາແຮງ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Replied High Priority"
msgstr "ຕອບກັບແລ້ວ ຄວາມສໍາຄັນສູງ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Schedule Call"
msgstr "ກໍານົດເວລາການໂທ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Schedule Calls"
msgstr "ກໍານົດເວລາການໂທ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Send Email"
msgstr "ສົ່ງອີເມວ"

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid ""
"Send an email to new leads and assign them a high priority if they open it."
msgstr ""
"ສົ່ງອີເມວຫາຜູ້ມີທ່າແຮງໃຫມ່ ແລະ ກໍານົດໃຫ້ເປັນຄວາມສໍາຄັນສູງ ຖ້າຫາກພວກເຂົາເປີດມັນ."

#. module: marketing_automation_crm
#. odoo-python
#: code:addons/marketing_automation_crm/models/marketing_campaign.py:0
msgid "Send welcome Email"
msgstr "ສົ່ງອີເມວຕ້ອນຮັບ"

